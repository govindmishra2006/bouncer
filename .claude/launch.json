{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/uvicorn bouncer.api:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && exec npm run dev -- --port 3000"],
      "port": 3000
    }
  ]
}
