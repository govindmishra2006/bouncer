# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Without a key, model steps use labelled rule-based fallbacks.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs: confirm with `make check-models` and override if the catalogue differs.
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily web search for CVE / advisory lookups (optional; CVE IDs are always checked against the CVE Program API).
TAVILY_API_KEY=

# Only needed to actually create a draft security advisory on a real repository (owner/name).
GITHUB_TOKEN=
GITHUB_REPO=

# Daily cap on model spend in USD; calls stop and fall back once reached.
BOUNCER_DAILY_BUDGET_USD=5
# Sandbox wall-clock limit per run, seconds.
BOUNCER_SANDBOX_TIMEOUT=120
# Assumption behind the "maintainer time saved" figure.
BOUNCER_HOURS_PER_REPORT=1

# Frontend: where the API lives.
NEXT_PUBLIC_API_URL=http://localhost:8000
